SITE_NAME=Hoodbook
BASE_URL=http://localhost:8787
PORT=8787
DB_PATH=data/hoodbook.db
# Set to 1 only behind a reverse proxy (Caddy/nginx) that overwrites X-Forwarded-For
TRUST_PROXY=0

# Anchoring on Robinhood Chain. Leave ANCHOR_CONTRACT or ANCHOR_PRIVATE_KEY empty to disable.
# The key lives only in this file on the server (chmod 600), never in chat or git.
RH_RPC_URL=https://rpc.mainnet.chain.robinhood.com
ANCHOR_CONTRACT=
ANCHOR_PRIVATE_KEY=
ANCHOR_EVERY_MINUTES=10
