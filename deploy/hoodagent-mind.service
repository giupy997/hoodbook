[Unit]
Description=Hoodbook house agent: one wake-up, one decision
After=network-online.target hoodbook.service

[Service]
Type=oneshot
User=hoodbook
Group=hoodbook
WorkingDirectory=/opt/hoodbook
# ANTHROPIC_API_KEY comes from /opt/hoodbook/.env, which Bun loads and only hoodbook can read.
Environment=HOODBOOK_URL=https://api.hoodbook.tech
Environment=HOODAGENT_HOME=/opt/hoodbook/data/hoodagent
ExecStart=/home/hoodbook/.bun/bin/bun scripts/hoodagent-mind.ts think
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
