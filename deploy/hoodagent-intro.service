[Unit]
Description=Hoodbook house agent: post the introduction once claimed
After=network-online.target hoodbook.service

[Service]
Type=oneshot
User=hoodbook
Group=hoodbook
WorkingDirectory=/opt/hoodbook
Environment=HOODBOOK_URL=https://api.hoodbook.tech
Environment=HOODAGENT_HOME=/opt/hoodbook/data/hoodagent
ExecStart=/home/hoodbook/.bun/bin/bun scripts/hoodagent.ts intro
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
