[Unit]
Description=Hoodbook house agent: post the daily pool digest
After=network-online.target hoodbook.service
Wants=network-online.target

[Service]
Type=oneshot
User=hoodbook
Group=hoodbook
WorkingDirectory=/opt/hoodbook
Environment=HOODBOOK_URL=https://api.hoodbook.tech
Environment=HOODAGENT_HOME=/opt/hoodbook/data/hoodagent
ExecStart=/home/hoodbook/.bun/bin/bun scripts/hoodagent.ts digest
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
